{
  "taint_sources": [
    "request", "input", "environ", "argv", "os.environ", "sys.argv"
  ],
  "rules": [
    {
      "id": "SQLI_WEB_001",
      "title": "SQL Injection (Web API)",
      "severity": "HIGH",
      "context": "WEB",
      "cwe": "CWE-89",
      "sinks": [
        "execute", "executemany", "executescript", "run_query"
      ],
      "regex": "^\\s*(SELECT|INSERT|UPDATE|DELETE|MERGE|UPSERT|REPLACE|DROP|ALTER|TRUNCATE|CREATE|GRANT|REVOKE|CALL|WITH)\\b"
    },
    {
      "id": "CMD_LOCAL_001",
      "title": "Command Injection (Local CLI)",
      "severity": "CRITICAL",
      "context": "LOCAL",
      "cwe": "CWE-78",
      "sinks": [
        "system", "Popen", "run", "call", "check_output"
      ],
      "regex": "" 
    },
    {
      "id": "CMD_WEB_001",
      "title": "Command Injection (Web API)",
      "severity": "CRITICAL",
      "context": "WEB",
      "cwe": "CWE-78",
      "sinks": [
        "system", "Popen", "run", "call", "check_output"
      ],
      "regex": "" 
    },
    {
      "id": "PT_WEB_001",
      "title": "Path Traversal (Web API)",
      "severity": "HIGH",
      "context": "WEB",
      "cwe": "CWE-22",
      "sinks": [
        "open", "send_file", "send_from_directory", "read_text", "read_bytes"
      ],
      "regex": ""
    },
    {
      "id": "SSRF_WEB_001",
      "title": "Server-Side Request Forgery (Web API)",
      "severity": "HIGH",
      "context": "WEB",
      "cwe": "CWE-918",
      "sinks": [
        "get", "post", "request", "urlopen", "urlretrieve"
      ],
      "regex": ""
    }
  ]
}